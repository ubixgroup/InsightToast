# Required for interactive (live) sessions only. The demo mode at /demo works without any of these.

# API key for authenticating with the backend service (see ../backend, POST /v2/admin/api-keys).
VITE_APP_API_KEY=""

# Base URL of the backend API server, e.g. "http://localhost:4343" for a local backend.
VITE_API_BASE_URL=""

# LiveKit server WebSocket URL, used for video conferencing in remote sessions.
# A free-tier LiveKit Cloud (https://cloud.livekit.io/) account provides sufficient credits.
VITE_LIVEKIT_URL=""

# Conversation ID for loading the demo session (see ../backend/demo).
VITE_DEMO_ID=""
