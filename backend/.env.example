# Required: Google Cloud API key with access to the Gemini API (primary LLM provider).
GOOGLE_API_KEY="..."

# Required: password for admin endpoints (used to generate API keys). Change from the default.
ADMIN_PASSWORD="1234"

# Required for the /v2/conversations/{id}/chat endpoint (direct Gemini chat with the client).
# Can be the same value as GOOGLE_API_KEY.
FRONTEND_GOOGLE_API_KEY="..."

# Optional: only needed to regenerate the viz-generator reference docs in pipeline/helper/,
# not required to run the pipeline.
FIRECRAWL_API_KEY="..."

# Docker Compose service URLs (auto-set by docker-compose.yml; override only for non-Docker setups)
QDRANT_URL="http://qdrant:6333"
OLLAMA_BASE_URL="http://ollama:11434"

# Optional host port overrides (useful when running alongside another instance on the same host)
API_HOST_PORT="4343"
QDRANT_HOST_PORT="6333"
OLLAMA_HOST_PORT="11435"

# Optional overrides
QDRANT_COLLECTION="parliament_documents"

# Optional API module override (helps if package/module names change later)
API_APP_MODULE="API.main:app"

# Optional Ollama models for auto-pull init container
OLLAMA_EMBEDDING_MODEL="embeddinggemma:latest"
OLLAMA_MAIN_MODEL="gemma3:12b"

# Optional: TTL, in seconds, for conversations created without prior registration
V2_UNREGISTERED_CONVERSATION_TTL_SECONDS="900"

# Optional: real-time audio ingestion clients
LIVEKIT_API_KEY="..."
LIVEKIT_API_SECRET="..."
LIVEKIT_URL="..."
DEEPGRAM_API_KEY="..."
SPEECHMATICS_API_KEY="..."
